{
  "name": "everbot",
  "version": "2.0.6",
  "description": "Terminal-based robot allocation system for EverBot Solutions",
  "main": "dist/index.js",
  "bin": {
    "everbot": "./dist/cli/bin.js"
  },
  "scripts": {
    "build": "tsc && npm run copy:migrations && npm run chmod:bin && npm run bundle",
    "bundle": "esbuild dist/cli/bin.js --bundle --platform=node --format=cjs --external:better-sqlite3 --external:pino/lib/worker.js --external:pino-roll --external:pino-pretty --outfile=dist/cli/bundle.js",
    "copy:migrations": "mkdir -p dist/infrastructure/db/migrations && cp src/infrastructure/db/migrations/*.sql dist/infrastructure/db/migrations/",
    "chmod:bin": "chmod +x dist/cli/bin.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "better-sqlite3": "^12.6.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "pino-roll": "^1.1.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pkg": {
    "scripts": [
      "node_modules/better-sqlite3/lib/**/*.js",
      "node_modules/bindings/**/*.js"
    ],
    "assets": [
      "node_modules/pino/lib/worker.js",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "node_modules/pino-roll/**/*",
      "node_modules/pino-pretty/**/*",
      "node_modules/pino-abstract-transport/**/*",
      "node_modules/sonic-boom/**/*",
      "node_modules/thread-stream/**/*",
      "node_modules/colorette/**/*",
      "node_modules/dateformat/**/*",
      "node_modules/fast-copy/**/*",
      "node_modules/fast-safe-stringify/**/*",
      "node_modules/help-me/**/*",
      "node_modules/joycon/**/*",
      "node_modules/minimist/**/*",
      "node_modules/on-exit-leak-free/**/*",
      "node_modules/pump/**/*",
      "node_modules/readable-stream/**/*",
      "node_modules/secure-json-parse/**/*",
      "node_modules/strip-json-comments/**/*"
    ]
  }
}
