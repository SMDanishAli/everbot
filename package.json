{
  "name": "everbot",
  "version": "1.0.5",
  "description": "Terminal-based robot allocation system for EverBot Solutions",
  "main": "dist/index.js",
  "bin": {
    "everbot": "./dist/cli/bin.js"
  },
  "scripts": {
    "build": "tsc && npm run copy:migrations && npm run chmod:bin",
    "copy:migrations": "mkdir -p dist/infrastructure/db/migrations && cp src/infrastructure/db/migrations/*.sql dist/infrastructure/db/migrations/",
    "chmod:bin": "chmod +x dist/cli/bin.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "better-sqlite3": "^12.6.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "pino-roll": "^1.1.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
